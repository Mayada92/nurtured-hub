---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaperCard from '../../components/PaperCard.astro';
import SectionReveal from '../../components/SectionReveal';
import { getCollection } from 'astro:content';

const papers = (await getCollection('papers'))
  .filter((p) => p.data.lang === 'en')
  .sort((a, b) => b.data.year - a.data.year);

const patents = papers.filter((p) => p.data.venue.includes('Patent'));
const regularPapers = papers.filter((p) => !p.data.venue.includes('Patent'));
const paperCount = regularPapers.length;
const patentCount = patents.length;
---

<BaseLayout title="Papers & Patents" description="Research papers, publications, and patents" lang="en">
  <section class="section">
    <div class="container">
      <SectionReveal client:load>
        <h1>Papers & Patents</h1>
        <p>Research publications and academic work. <span class="paper-count">({paperCount} papers, {patentCount} patents)</span></p>
      </SectionReveal>
      <div class="grid grid--papers">
        {papers.map((paper) => (
          <PaperCard paper={paper} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :global(body)::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url('/images/background/background6.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    opacity: 0.2;
    z-index: -1;
    pointer-events: none;
  }

  .section {
    padding-block: var(--space-8);
  }

  .grid {
    display: grid;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  .grid--papers {
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }

  @media (min-width: 768px) {
    .grid--papers {
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    }
  }

  .paper-count {
    color: var(--color-muted-ink);
    font-size: 0.65625rem;
    font-weight: 500;
  }
</style>



