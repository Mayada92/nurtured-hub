---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AnimatedBackground from '../../../components/AnimatedBackground';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getImagePath } from '../../../utils/path';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.lang === 'en');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
const date = new Date(post.data.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={post.data.title} description={post.data.excerpt} lang="en">
  <AnimatedBackground client:load type="bubbles" density={55} speed={0.3} opacity={0.35} />
  <article class="post">
    <header class="post__header">
      <time datetime={post.data.date.toISOString()} class="post__date">
        {date}
      </time>
      <h1>{post.data.title}</h1>
      {post.data.cover && (
        <div class="post__cover">
          <img
            src={getImagePath(post.data.cover)}
            alt={`${post.data.title} - Cover image`}
            loading="eager"
            width="1200"
            height="600"
          />
        </div>
      )}
    </header>
    <div class="post__content">
      <Content />
    </div>

    <script>
      // Fix image paths and internal links in markdown content
      (function() {
        const basePath = import.meta.env.BASE_URL || '/';
        const content = document.querySelector('.post__content');
        if (!content) return;
        
        // Fix image paths
        const images = content.querySelectorAll('img');
        images.forEach((img) => {
          const src = img.getAttribute('src');
          if (src && src.startsWith('/') && !src.startsWith(basePath)) {
            const cleanPath = src.startsWith('/') ? src.slice(1) : src;
            img.src = `${basePath}${cleanPath}`.replace(/\/+/g, '/');
          }
        });
        
        // Fix internal links (links starting with /en/ or /ar/)
        const links = content.querySelectorAll('a[href^="/en/"], a[href^="/ar/"]');
        links.forEach((link) => {
          const href = link.getAttribute('href');
          if (href && !href.startsWith(basePath)) {
            // Remove leading slash and add base path
            const cleanPath = href.startsWith('/') ? href.slice(1) : href;
            link.href = `${basePath}${cleanPath}`.replace(/\/+/g, '/');
          }
        });
      })();
    </script>
    {post.data.canonical_url && (
      <footer class="post__footer">
        <p>
          <a href={post.data.canonical_url} target="_blank" rel="noopener noreferrer">
            {post.data.canonical_url.includes('medium.com') 
              ? 'Read on Medium →' 
              : post.data.canonical_url.includes('linkedin.com') 
              ? 'Read on LinkedIn →' 
              : 'Read original article →'}
          </a>
        </p>
      </footer>
    )}
  </article>
</BaseLayout>

<style>
  .post {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding: var(--space-8) var(--space-4);
    position: relative;
  }

  .post::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url('/images/background/background4.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    opacity: 0.25;
    z-index: -3;
    pointer-events: none;
  }

  .post__header {
    margin-block-end: var(--space-8);
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .post__date {
    display: block;
    font-size: var(--font-size-small);
    color: var(--color-muted-ink);
    margin-block-end: var(--space-3);
  }

  .post h1 {
    font-size: var(--font-size-h1);
    color: #2d7a4f; /* Green matching the theme */
    text-shadow: 0 2px 8px rgba(255, 255, 255, 0.5), 0 4px 12px rgba(45, 122, 79, 0.2);
    font-weight: 700;
    line-height: 1.2;
    margin-block-end: var(--space-6);
  }

  .post__cover {
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-xl);
    margin-block-end: var(--space-6);
    box-shadow: var(--shadow-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--gradient-section);
  }

  .post__cover img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .post__content {
    font-size: var(--font-size-body);
    line-height: 1.8;
    color: var(--color-ink);
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .post__content :global(h2) {
    font-size: var(--font-size-h2);
    margin-block-start: var(--space-8);
    margin-block-end: var(--space-4);
    color: var(--color-ink);
  }

  .post__content :global(h3) {
    font-size: var(--font-size-h3);
    margin-block-start: var(--space-6);
    margin-block-end: var(--space-3);
    color: var(--color-ink);
  }

  .post__content :global(p) {
    margin-block-end: var(--space-4);
  }

  /* Default: make all images smaller (50% width) */
  .post__content :global(img) {
    width: 50% !important;
    max-width: 600px !important;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-lg);
    margin-block: var(--space-6);
    margin-inline: auto;
    box-shadow: var(--shadow-md);
    display: block;
  }

  /* Keep ONLY the first image (FIGURE 1a - before Introduction) large */
  /* The first image is in the first paragraph before the first h2 */
  .post__content > :global(p:first-of-type) :global(img) {
    width: 100% !important;
    max-width: 100% !important;
  }

  .post__content :global(ul),
  .post__content :global(ol) {
    margin-block: var(--space-4);
    padding-inline-start: var(--space-6);
  }

  .post__content :global(li) {
    margin-block-end: var(--space-2);
  }

  .post__footer {
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid rgba(0, 0, 0, 0.1);
  }

  .post__footer a {
    color: var(--color-accent-1);
    text-decoration: none;
    font-weight: 500;
  }

  .post__footer a:hover {
    text-decoration: underline;
  }
</style>

