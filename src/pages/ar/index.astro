---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FloatingLayer from '../../components/FloatingLayer';
import SectionReveal from '../../components/SectionReveal';
import ImageStage from '../../components/ImageStage';
import ProjectCard from '../../components/ProjectCard.astro';
import PostCard from '../../components/PostCard.astro';
import StatsSection from '../../components/StatsSection';
import Icon from '../../components/Icon.astro';
import AnimatedBackground from '../../components/AnimatedBackground';
import { getCollection } from 'astro:content';
import { getBasePath, getImagePath } from '../../utils/path';
import { compareByRecency } from '../../utils/sort';

const base = getBasePath();

const featuredProjects = (await getCollection('projects'))
  .filter((p) => p.data.lang === 'ar')
  .sort((a, b) => {
    const diff = compareByRecency(a, b);
    if (diff !== 0) return diff;
    return a.data.title.localeCompare(b.data.title);
  })
  .slice(0, 6);

const recentPosts = (await getCollection('posts'))
  .filter((p) => p.data.lang === 'ar')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const allPosts = await getCollection('posts');
const postCount = allPosts.filter((p) => p.data.lang === 'ar').length;

// Calculate actual stats from content
const allProjects = await getCollection('projects');
const allPapers = await getCollection('papers');
const allWork = await getCollection('work');

// Calculate years of experience (from 2017 when started at Saudi Aramco to now)
const workStartYear = 2017; // Started at Saudi Aramco in October 2017
const currentYear = new Date().getFullYear();
const yearsExperience = currentYear - workStartYear;

// Count projects (Arabic only for display)
const projectCount = allProjects.filter((p) => p.data.lang === 'ar').length;

// Count publications/papers
const paperCount = allPapers.filter((p) => p.data.lang === 'ar').length;

// Domains are fixed: sports, educational-psychology, engineering, data-science
const domainCount = 4;

const stats = [
  { number: yearsExperience.toString(), label: 'سنوات خبرة' },
  { number: projectCount.toString(), label: 'مشاريع' },
  { number: paperCount.toString(), label: 'منشورات' },
  { number: domainCount.toString(), label: 'مجالات' },
];
---

<BaseLayout
  title="الرئيسية"
  description="مرحباً بك في العقل المربى - محفظة ثنائية اللغة تعرض المشاريع والكتابات والملفات الشخصية المهنية"
  lang="ar"
>
  <AnimatedBackground client:load type="bubbles" density={60} speed={0.3} opacity={0.4} />
  <div class="landing-page">
    <div class="landing-page__overlay"></div>
    <FloatingLayer client:load />
    <section class="hero">
      <div class="hero__background">
        <div class="hero__light-overlay"></div>
        <div class="hero__overlay"></div>
        <div class="hero__gradient"></div>
      </div>
      <div class="container">
        <div class="hero__banner"></div>
        <SectionReveal client:load>
          <div class="hero__content">
            <div class="hero__logo">
              <img src={getImagePath('/images/brand/nurtured-mind-logo.jpg')} alt="العقل المربى" width="180" height="180" />
            </div>
            <div class="hero__badge">ميادة الهاشم | مهندسة • عالمة بيانات • مبتكرة في التقنية التعليمية</div>
            <h1>مرحباً بك في العقل المربى</h1>
            <p class="hero__subtitle">
              محفظة أعمال متعددة التخصصات تستكشف تقاطع الهندسة وعلم البيانات والتعليم.
              تربط الخبرة التقنية بالابتكار الذي يركز على الإنسان.
            </p>

            {/* WORK SECTION - PRIMARY - Large prominent cards */}
            <div class="hero__work">
              <h2 class="hero__work-title">🎯 استكشف أعمالي</h2>
              <div class="hero__work-grid">
                <a href={`${base}ar/projects`.replace(/\/+/g, '/')} class="work-card work-card--projects">
                  <div class="work-card__icon">
                    <Icon name="folder" size={48} />
                  </div>
                  <div class="work-card__content">
                    <h3 class="work-card__title">🚀 المشاريع</h3>
                    <div class="work-card__count">{projectCount}+ مشروعاً</div>
                    <p class="work-card__desc">من التقنية التعليمية إلى التعلم الآلي، ومن هندسة البيانات إلى تطبيقات الذكاء الاصطناعي</p>
                    {featuredProjects.slice(0, 3).length > 0 && (
                      <div class="work-card__preview">
                        <div class="work-card__preview-label">الأحدث:</div>
                        <div class="work-card__preview-items">
                          {featuredProjects.slice(0, 3).map((p) => (
                            <span class="work-card__preview-item">{p.data.title.length > 20 ? p.data.title.substring(0, 20) + '...' : p.data.title}</span>
                          ))}
                        </div>
                      </div>
                    )}
                    <div class="work-card__cta">عرض جميع المشاريع ({projectCount}+) ←</div>
                  </div>
                </a>

                <a href={`${base}ar/writing`.replace(/\/+/g, '/')} class="work-card work-card--blog">
                  <div class="work-card__icon">
                    <Icon name="document" size={48} />
                  </div>
                  <div class="work-card__content">
                    <h3 class="work-card__title">✍️ المدونة</h3>
                    <div class="work-card__count">{postCount}+ مقالاً</div>
                    <p class="work-card__desc">حول الذكاء الاصطناعي، وعلم النفس التربوي، وعلم البيانات</p>
                    {recentPosts.length > 0 && (
                      <div class="work-card__preview">
                        <div class="work-card__preview-label">الأحدث:</div>
                        <ul class="work-card__preview-list">
                          {recentPosts.map((post) => (
                            <li class="work-card__preview-item">"{post.data.title.length > 35 ? post.data.title.substring(0, 35) + '...' : post.data.title}" ({new Date(post.data.date).getFullYear()})</li>
                          ))}
                        </ul>
                      </div>
                    )}
                    <div class="work-card__cta">قراءة جميع المقالات ←</div>
                  </div>
                </a>

                <a href={`${base}ar/papers`.replace(/\/+/g, '/')} class="work-card work-card--papers">
                  <div class="work-card__icon">
                    <Icon name="academic" size={48} />
                  </div>
                  <div class="work-card__content">
                    <h3 class="work-card__title">📄 المنشورات</h3>
                    <div class="work-card__count">{paperCount} منشوراً</div>
                    <p class="work-card__desc">أوراق مؤتمرات، وبراءات اختراع، وأبحاث</p>
                    <div class="work-card__preview">
                      <ul class="work-card__preview-list">
                        <li class="work-card__preview-item">• براءتا اختراع أمريكيتان</li>
                        <li class="work-card__preview-item">• {paperCount} أوراق مؤتمرات (IPTC، MEALC)</li>
                        <li class="work-card__preview-item">• رئاسة جلسة في MEALC 2024</li>
                      </ul>
                    </div>
                    <div class="work-card__cta">عرض جميع المنشورات ←</div>
                  </div>
                </a>
              </div>
            </div>

            {/* PATHWAYS SECTION - SECONDARY - Smaller, below work */}
            <div class="hero__pathways">
              <p class="hero__pathways-subtitle">أو استكشف حسب مجال الخبرة:</p>
              <div class="hero__pathways-grid">
                <a href={`${base}ar/profile/engineering`.replace(/\/+/g, '/')} class="pathway-button pathway-button--engineering">
                  <Icon name="code" size={18} />
                  <span class="pathway-button__title">الهندسة</span>
                </a>
                <a href={`${base}ar/profile/data-science`.replace(/\/+/g, '/')} class="pathway-button pathway-button--data-science">
                  <Icon name="chart" size={18} />
                  <span class="pathway-button__title">علم البيانات</span>
                </a>
                <a href={`${base}ar/profile/children-education`.replace(/\/+/g, '/')} class="pathway-button pathway-button--education">
                  <Icon name="book" size={18} />
                  <span class="pathway-button__title">التعليم</span>
                </a>
              </div>
            </div>
          </div>
        </SectionReveal>
      </div>
    </section>

    <section class="section section--stats">
      <div class="container">
        <StatsSection client:load stats={stats} />
      </div>
    </section>

    <section class="section section--story">
      <div class="container">
        <div class="story-grid">
          <SectionReveal client:load delay={0.1}>
            <div class="story-content">
              <h2>مدفوعة بالبيانات، تسعى بهدف</h2>
              <p>
                أستخدم علم البيانات والهندسة لحل مشكلات معقدة وابتكار حلول ذات أثر. من علم النفس التربوي
                إلى خطوط أنابيب التعلم الآلي، يربط عملي بين مجالات متعددة لإحداث تغيير هادف.
              </p>
              <p>
                استكشف محفظة أعمالي لترى كيف يلتقي الفضول والبيانات والهدف في مشاريع تمتد عبر التعليم والتقنية والأثر الاجتماعي.
              </p>
            </div>
          </SectionReveal>
          <SectionReveal client:load delay={0.2}>
            <div class="story-image">
              <ImageStage
                src={getImagePath('/images/brand/nurtured-mind-logo.jpg')}
                alt="صورة العقل المربى"
                width={600}
                height={600}
                parallax={true}
              />
            </div>
          </SectionReveal>
        </div>
      </div>
    </section>

    <section class="section section--projects">
      <div class="container">
        <SectionReveal client:load delay={0.1}>
          <div class="section-header">
            <h2>مشاريع مميزة</h2>
            <p class="section-subtitle">سواء في هندسة البيانات أو التحليل أو التعلم الآلي، عملي متجذر في الهدف.</p>
          </div>
          <div class="grid grid--projects">
            {featuredProjects.map((project, i) => (
              <SectionReveal client:load delay={0.1 + i * 0.1}>
                <ProjectCard project={project} />
              </SectionReveal>
            ))}
          </div>
        </SectionReveal>
      </div>
    </section>

    <section class="section section--writing">
      <div class="container">
        <SectionReveal client:load delay={0.2}>
          <div class="section-header">
            <h2>كتابات حديثة</h2>
            <p class="section-subtitle">أفكار ورؤى ودروس مستفادة من رحلتي عبر مجالات متعددة.</p>
          </div>
          <div class="grid grid--posts">
            {recentPosts.map((post, i) => (
              <SectionReveal client:load delay={0.2 + i * 0.1}>
                <PostCard post={post} />
              </SectionReveal>
            ))}
          </div>
        </SectionReveal>
      </div>
    </section>

    <section class="section section--banner">
      <div class="container">
        <SectionReveal client:load delay={0.3}>
          <div class="banner">
            <div class="banner__logo">
              <img src={`${base}images/brand/nurtured-mind-logo.jpg`.replace(/\/+/g, '/')} alt="العقل المربى" width="120" height="120" />
            </div>
            <h2>العقل المربى</h2>
            <p>
              منصة لاستكشاف تقاطع التعليم والبيانات والتأثير الاجتماعي.
              ربط وجهات النظر من خلال البحث والكتابة والتطبيقات العملية.
            </p>
          </div>
        </SectionReveal>
      </div>
    </section>
  </div>
</BaseLayout>


<style>
  .landing-page {
    position: relative;
    min-height: 100vh;
  }

  .landing-page__overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 50vh;
    background-image: url('/images/background/background1.png');
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    opacity: 0.4;
    z-index: -3;
    pointer-events: none;
  }

  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-block: var(--space-8);
    padding-block-end: var(--space-12);
    overflow: hidden;
  }

  .hero__background {
    position: absolute;
    inset: 0;
    z-index: -3;
    background-image: url('/images/background/background3.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 1;
  }

  .hero__light-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom,
      rgba(255, 255, 255, 0.5) 0%,
      rgba(255, 255, 255, 0.3) 30%,
      rgba(255, 255, 255, 0.15) 60%,
      rgba(255, 255, 255, 0) 100%);
    z-index: 0;
    pointer-events: none;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: transparent;
    z-index: 3;
    pointer-events: none;
  }

  .hero__gradient {
    position: absolute;
    inset: 0;
    background: transparent;
    z-index: 1;
    pointer-events: none;
  }

  .hero__banner {
    position: absolute;
    top: var(--space-8);
    left: var(--space-8);
    right: var(--space-8);
    bottom: var(--space-8);
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(8px);
    border-radius: var(--radius-xl);
    z-index: 1;
    pointer-events: none;
    min-height: fit-content;
  }

  .hero__content {
    position: relative;
    z-index: 10; /* Above scroll overlay */
    max-width: var(--hero-content-width);
    margin-inline: auto;
  }

  .hero__logo {
    margin-block-end: var(--space-3);
    display: flex;
    justify-content: center;
  }

  .hero__logo img {
    width: 180px;
    height: 180px;
    object-fit: contain;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.1));
  }

  .hero__badge {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(26, 26, 26, 0.1);
    border-radius: var(--radius-xl);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-muted-ink);
    margin-block-end: var(--space-3);
    backdrop-filter: blur(10px);
  }

  .hero h1 {
    font-size: clamp(1.4rem, 3.5vw, 2.5rem);
    font-weight: 700;
    line-height: 1.35;
    padding-block-start: 0.15em;
    margin-block-end: var(--space-3);
    letter-spacing: -0.03em;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 8s ease-in-out infinite;
    background-size: 200% 200%;
  }

  @keyframes gradientShift {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .hero__subtitle {
    font-size: clamp(1rem, 1.8vw, 1.1875rem);
    color: var(--color-ink);
    margin-block-end: var(--space-5);
    max-width: var(--hero-content-width);
    margin-inline: auto;
    line-height: 1.8;
    font-weight: 500;
  }

  /* WORK SECTION - PRIMARY - Large prominent cards */
  .hero__work {
    margin-block: var(--space-5);
    position: relative;
  }

  .hero__work-title {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 700;
    text-align: center;
    margin-block-end: var(--space-5);
    color: var(--color-ink);
    letter-spacing: -0.02em;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__work-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-block-end: var(--space-5);
  }

  .work-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5);
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border: 2px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--radius-xl);
    text-decoration: none;
    transition: all var(--motion-duration-normal) var(--motion-easing-smooth);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.12);
    min-height: 320px;
    position: relative;
    overflow: hidden;
  }

  .work-card::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--motion-duration-normal) var(--motion-easing-smooth);
    z-index: 0;
  }

  .work-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
    border-color: transparent;
  }

  .work-card:hover::before {
    opacity: 1;
  }

  .work-card__icon {
    z-index: 1;
    position: relative;
  }

  .work-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    background: rgba(139, 92, 246, 0.15);
    border-radius: var(--radius-xl);
    margin-block-end: var(--space-3);
    border: 2px solid rgba(139, 92, 246, 0.2);
    transition: all var(--motion-duration-normal) var(--motion-easing-smooth);
  }

  .work-card:hover .work-card__icon {
    transform: scale(1.1);
    border-color: rgba(139, 92, 246, 0.4);
  }

  .work-card__icon svg {
    width: 48px;
    height: 48px;
    color: var(--color-accent-1);
    transition: transform var(--motion-duration-normal) var(--motion-easing-smooth);
  }

  .work-card:hover .work-card__icon svg {
    transform: scale(1.1);
  }

  .work-card--projects .work-card__icon {
    background: rgba(6, 182, 212, 0.15);
    border-color: rgba(6, 182, 212, 0.3);
  }

  .work-card--projects .work-card__icon svg {
    color: #06b6d4;
  }

  .work-card--blog .work-card__icon {
    background: rgba(139, 92, 246, 0.15);
    border-color: rgba(139, 92, 246, 0.3);
  }

  .work-card--blog .work-card__icon svg {
    color: #8b5cf6;
  }

  .work-card--papers .work-card__icon {
    background: rgba(245, 158, 11, 0.15);
    border-color: rgba(245, 158, 11, 0.3);
  }

  .work-card--papers .work-card__icon svg {
    color: #f59e0b;
  }

  .work-card__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    z-index: 1;
    position: relative;
  }

  .work-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
    transition: color var(--motion-duration-fast) var(--motion-easing);
    line-height: 1.3;
  }

  .work-card__count {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-accent-1);
    transition: color var(--motion-duration-fast) var(--motion-easing);
  }

  .work-card--projects .work-card__count {
    color: #06b6d4;
  }

  .work-card--blog .work-card__count {
    color: #8b5cf6;
  }

  .work-card--papers .work-card__count {
    color: #f59e0b;
  }

  .work-card__desc {
    font-size: 0.875rem;
    color: var(--color-muted-ink);
    line-height: 1.5;
    margin: 0;
    transition: color var(--motion-duration-fast) var(--motion-easing);
  }

  .work-card__preview {
    margin-block-start: var(--space-2);
    padding-block-start: var(--space-2);
    border-block-start: 1px solid rgba(0, 0, 0, 0.1);
  }

  .work-card__preview-label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted-ink);
    margin-block-end: var(--space-1);
    transition: color var(--motion-duration-fast) var(--motion-easing);
  }

  .work-card__preview-items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .work-card__preview-item {
    font-size: 0.75rem;
    color: var(--color-muted-ink);
    transition: color var(--motion-duration-fast) var(--motion-easing);
  }

  .work-card__preview-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .work-card__preview-list .work-card__preview-item {
    font-size: 0.75rem;
    color: var(--color-muted-ink);
    transition: color var(--motion-duration-fast) var(--motion-easing);
  }

  .work-card__cta {
    margin-block-start: auto;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-accent-1);
    transition: color var(--motion-duration-fast) var(--motion-easing);
    padding-block-start: var(--space-2);
    border-block-start: 1px solid rgba(0, 0, 0, 0.08);
  }

  .work-card--projects .work-card__cta {
    color: #06b6d4;
  }

  .work-card--blog .work-card__cta {
    color: #8b5cf6;
  }

  .work-card--papers .work-card__cta {
    color: #f59e0b;
  }

  .work-card:hover .work-card__title,
  .work-card:hover .work-card__count,
  .work-card:hover .work-card__desc,
  .work-card:hover .work-card__preview-label,
  .work-card:hover .work-card__preview-item,
  .work-card:hover .work-card__cta {
    color: white;
  }

  .work-card--projects::before {
    background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
  }

  .work-card--blog::before {
    background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
  }

  .work-card--papers::before {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  }

  /* PATHWAYS SECTION - SECONDARY - Smaller, below work */
  .hero__pathways {
    margin-block: var(--space-5);
    position: relative;
    padding: var(--space-3) var(--space-4);
