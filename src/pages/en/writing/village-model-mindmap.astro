---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VillageModelMindMap from '../../../components/VillageModelMindMap';
---

<BaseLayout title="Village Model Mind Map" description="An interactive visualization of the Village Model of Social and Emotional Development" lang="en">
  <VillageModelMindMap client:load />
</BaseLayout>

<style>
  :global(body) {
    overflow-x: hidden;
  }

  @keyframes pulse {
    0%, 100% {
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      transform: translate(-50%, -50%) scale(1.05);
    }
  }
</style>

